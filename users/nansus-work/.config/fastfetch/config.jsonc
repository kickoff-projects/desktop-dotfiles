/* nansus-work: black/rainbow variant of
   common/.config/fastfetch/config.jsonc. Module layout, keys, glyphs and
   formats are unchanged - only the key/separator/logo colors moved from
   the basic ansi names to 256-color codes, so the four module groups read
   as magenta -> violet -> cyan -> green down the page. The logo and the
   color bar at the bottom still come from common/.config/fastfetch.

   The four group hues are now 24-bit truecolor neon instead of the 256-color
   approximations: keys are the neon value with the bold attribute (1;38;2;..)
   and each module's "outputColor" is the same neon value unbolded, so the
   information itself glows in its group color instead of printing in the
   terminal's default foreground. The separator and the percent/temperature
   state colors follow the same neon set (see ../hypr/UserConfigs/palette.conf
   and ../waybar/colors.css). The logo "color": {"1": ...} is deliberately
   left at 38;5;201 - the cheshire cat keeps its original magenta. */
/*don't forget to adde this to .zshrc:*/
/*fastfetch -c ~/.dotfiles/hosts/Home-Desktop/.config/fastfetch/mystical-config.jsonc --color-separator 31*/

{
"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
"logo": {
    /*"source": "~/.config/fastfetch/Mad_Hatter.txt",*/
    "source": "~/.config/fastfetch/moved_chesire_cat_with_text",
    /*"source": "~/.config/fastfetch/testing_no_room_v4",*/

  "color": {
     /*"1": "green"*/
     "1": "38;5;201"
  },
  "padding": {
     "top": 1
  }
},

"display": {
	
    "bar": {
      "char": {
	"elapsed": "/"
      },
      "charTotal": "/",
      "width": 6
    },

    "percent": {
      "type": 9,
      "color": {
        "green": "38;2;0;255;156",
        "yellow": "38;2;246;255;0",
	"red": "38;2;255;36;71"
      },
      "ndigits": 2
    },		/* 󰑃 */
   "separator": "~> ",
   "color": {
     "separator": "38;2;255;90;230",
     "output": "38;2;0;255;255"
   }
},

"modules": [
    "break",
    {
    "type": "os",
    /*In case of \n use something like: \n\t\t\t\t\t\t\t to
      move "Distro" to it place */
    "key": " DISTRO ",
    "outputColor": "38;2;255;16;240",
    "keyColor": "1;38;2;255;16;240"
    },
    {
    "type": "bios",
    "key": "/│/ ╠ ",
    "outputColor": "38;2;255;16;240",
    "keyColor": "1;38;2;255;16;240",
    "format": "{5}"
    },
    {
    "type": "kernel",
    "key": "/│/ ╠ ",
    "outputColor": "38;2;255;16;240",
    "keyColor": "1;38;2;255;16;240"
    },
    {
    "type": "shell",
    "key": "/│/ ╠ ",
    "outputColor": "38;2;255;16;240",
    "keyColor": "1;38;2;255;16;240"
    },
    {
    "type": "packages",
    "key": "/│/ ╠ ",
    "outputColor": "38;2;255;16;240",
    "keyColor": "1;38;2;255;16;240"
    },
    {
    "type": "Processes",
    "key": "/│/ ╠ ",
    "outputColor": "38;2;255;16;240",
    "keyColor": "1;38;2;255;16;240",
    "format": "{1} Active processes"
    },
    {
    "type": "wm",
    "key": " DE/WM ",
    "outputColor": "38;2;191;64;255",
    "keyColor": "1;38;2;191;64;255"
    },
    {
    "type": "wmtheme",
    "key": "/│/ ╠ ",
    "outputColor": "38;2;191;64;255",
    "keyColor": "1;38;2;191;64;255"
    },
    {
    "type": "icons",
    "key": "/│/ ╠ ",
    "outputColor": "38;2;191;64;255",
    "keyColor": "1;38;2;191;64;255"
    },
    {
        "type": "cursor",
        "key": "/│/ ╠ ",
        "outputColor": "38;2;191;64;255",
        "keyColor": "1;38;2;191;64;255",
    },
    {
        "type": "terminalfont",
        "key": "/│/ ╠ ",
        "outputColor": "38;2;191;64;255",
        "keyColor": "1;38;2;191;64;255",
    },
    {
    "type": "terminal",
    "key": "/│/ ╠ ",
    "outputColor": "38;2;191;64;255",
    "keyColor": "1;38;2;191;64;255"
    },
    {
    "type": "Board",
    "key": "󰌢 SYSTEM ",
    "outputColor": "38;2;0;255;255",
    "keyColor": "1;38;2;0;255;255",
    "format": "{1} {2}"
    },
    {
    "type": "cpu",
    "key": "/│/ ╠ ",
    "outputColor": "38;2;0;255;255",
    "keyColor": "1;38;2;0;255;255",
    "format": "{1}:"
    },
    {
    "type": "cpu",
    "showCoreCount": true,
    "temp": true,
    "key": "/│/ ╠    ╚ ",
    "outputColor": "38;2;0;255;255",
    "keyColor": "1;38;2;0;255;255",
    "format": "{3} Cores | {4} Logical Cores | {8}"
    },
    {
    "type": "cpu",
    "showCoreCount": true,
    "temp": true,
    "key": "/│/ ╠    ╚ ",
    "outputColor": "38;2;0;255;255",
    "keyColor": "1;38;2;0;255;255",
    "format": "Max: {7} | Base: {6}"
    },
    {
    "type": "CPUUsage",
    "percent": {
	"type": 9,
	"green": 83,
	"yellow": 89,
	"red": 94
    },
    "key": "/│/ ╠    ╚ ",
    "outputColor": "38;2;0;255;255",
    "keyColor": "1;38;2;0;255;255",
    "format": "Max: {2} | Avg: {1}"
    },
    {
    "type": "gpu",
    "key": "/│/ ╠ ",
    "format": "{1} {2}:",
    "outputColor": "38;2;0;255;255",
    "keyColor": "1;38;2;0;255;255"
    },
    {
    "type": "gpu",
    "key": "/│/ ╠    ╚ ",
    "format": "{3}",
    "outputColor": "38;2;0;255;255",
    "keyColor": "1;38;2;0;255;255"
    },
    {
    "type": "display",
    "key": "/│/ ╠ ",
    "outputColor": "38;2;0;255;255",
    "keyColor": "1;38;2;0;255;255",
    /*"compactType": "original-with-refresh-rate"*/
    "format": "{1} x {2} @ {3}Hz | {6}"
    },
    {
    "type": "memory",
    "percent": {
	"type": 3,
	"green": 50,
	"yellow": 80,
	"red": 93
    },
    "key": "/│/ ╠ ",
    "outputColor": "38;2;0;255;255",
    "keyColor": "1;38;2;0;255;255",
    "format": "{1}/{2}  {4}   "
    },
    {
    "type": "swap",
    "percent": {
	"type": 3,
	"green": 50,
	"yellow": 80,
	"red": 93
    },
    "key": "/│/ ╠ ",
    "outputColor": "38;2;0;255;255",
    "keyColor": "1;38;2;0;255;255",
    "format": "{1}/{2}       {4}   "
    },
    {
    "type": "uptime",
    "key": "/│/ ╠ ",
    "outputColor": "38;2;0;255;255",
    "keyColor": "1;38;2;0;255;255"
    },
    {
    "type": "TPM",
    "key": "/│/ ╠ ",
    "outputColor": "38;2;0;255;255",
    "keyColor": "1;38;2;0;255;255",
    "format": "{2}"
    },
    /*{
    "type": "localip",
    "key": "/│/ ╠ ",
    "outputColor": "38;2;0;255;255",
    "keyColor": "1;38;2;0;255;255"
    },*/
    {
      "type": "poweradapter",
      "keyIcon": "󰚥"
    },
    /*{
    "type": "host",
    "key": "/│/ ╠ ",
    "outputColor": "38;2;0;255;255",
    "keyColor": "1;38;2;0;255;255",
    "fallback": "Cool build bro! 😎",
    "format": "{1}{2}"
    },*/
    /*{
     "type": "command",
     "key": "Host",
     "text": "cat /sys/devices/virtual/dmi/id/product_name 2>/dev/null || echo 'Cool build bro! 😎'"
    },*/
    {
    "type": "sound",
    "key": " AUDIO ",
    "format": "{2:22} {5}",
    "outputColor": "38;2;0;255;156",
    "keyColor": "1;38;2;0;255;156",
    "percent": {
	"type": 3,
	"green": "100",
    }
    },
    {
    "type": "player",
    "key": "/│/ ╠ ",
    "outputColor": "38;2;0;255;156",
    "keyColor": "1;38;2;0;255;156"
    },
    {
    "type": "media",
    "key": "/│/ ╠ ",
    "outputColor": "38;2;0;255;156",
    "keyColor": "1;38;2;0;255;156"
    },
    /*{*/
    /*"type": "weather",*/
    /*"key": " ",*/
    /*is a lil' snowman :holding back tears:*/   
    /*"format": "  {1}",*/
    /*"timeout": 2000*/
    /*},*/
    "break",
    {
    "type": "custom",
    /*"format": "\u001b[90m  \u001b[31m  \u001b[32m  \u001b[33m  \u001b[34m  \u001b[35m  \u001b[36m  \u001b[37m  \u001b[38m  \u001b[39m  \u001b[39m    \u001b[38m  \u001b[37m  \u001b[36m  \u001b[35m  \u001b[34m  \u001b[33m  \u001b[32m  \u001b[31m  \u001b[90m "*/

    /*Great pastel coloring :smile:*/
    /*"format": "\u001b[38;5;153m  \u001b[38;5;159m  \u001b[38;5;151m  \u001b[38;5;218m  \u001b[38;5;182m  \u001b[38;5;159m  \u001b[38;5;151m  \u001b[38;5;218m  \u001b[38;5;182m  \u001b[38;5;153m  \u001b[38;5;159m  \u001b[38;5;151m  \u001b[38;5;218m  \u001b[38;5;182m  \u001b[38;5;159m  \u001b[38;5;151m  \u001b[38;5;218m  \u001b[38;5;182m  \u001b[38;5;153m  \u001b[38;5;159m  \u001b[38;5;151m  \u001b[0m"*/
    
    /*Slightly stronger pastel*/
    /*"format": "\u001b[38;5;117m  \u001b[38;5;120m  \u001b[38;5;212m  \u001b[38;5;207m  \u001b[38;5;117m  \u001b[38;5;120m  \u001b[38;5;212m  \u001b[38;5;207m  \u001b[38;5;117m  \u001b[38;5;120m  \u001b[38;5;212m  \u001b[38;5;207m  \u001b[38;5;117m  \u001b[38;5;120m  \u001b[38;5;212m  \u001b[38;5;207m  \u001b[38;5;117m  \u001b[38;5;120m  \u001b[38;5;212m  \u001b[38;5;207m  \u001b[0m"*/
    
    /*Best color so far and here one  */
    "format": "\u001b[38;5;99m  \u001b[38;5;117m  \u001b[38;5;120m  \u001b[38;5;164m  \u001b[38;5;213m  \u001b[38;5;219m  \u001b[38;5;159m  \u001b[38;5;123m  \u001b[38;5;99m  \u001b[38;5;117m  \u001b[38;5;120m  \u001b[38;5;164m  \u001b[38;5;213m  \u001b[38;5;219m  \u001b[38;5;159m  \u001b[38;5;123m  \u001b[38;5;99m  \u001b[38;5;117m  \u001b[38;5;120m  \u001b[0m"
    },
    "break",
    ]
}
