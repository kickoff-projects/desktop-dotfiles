/*Verbose fastfetch config. The default config path, so plain `fastfetch`*/
/*reads it, including the greeting on every new interactive shell.*/

{
"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
"logo": {
    /*"source": "~/.config/fastfetch/Mad_Hatter.txt",*/
    "source": "~/.config/fastfetch/moved_chesire_cat_with_text",
    /*"source": "~/.config/fastfetch/testing_no_room_v4",*/

  "color": {
     /*"1": "green"*/
     /*"1": "#CB039B",
     "2": "#c4b400",
     "3": "#ffffff",
     "4": "#B95CAB",
     "5": "#542DAE",
     "6": "#87D7FF",
     "7": "#875FFF",
     "8": "#487EFF",
     "9": "#87FF87"*/


     /*"1": "#7E0260",*/
     /*"1": "#570142",*/
     "1": "#300125",
     "2": "#fdee00",
     "3": "#ffffff",
     "4": "#B95CAB",
     /*"5": "#31127a",*/
     "5": "#1c0a47",
     "6": "#fdee00",
     "7": "#875FFF",
     "8": "#487EFF",
     "9": "#87FF87"

  },
  "padding": {
     "top": 1
  }
},

"display": {
	
    "bar": {
      "char": {
	"elapsed": "/",
	"total": "-"
      },
      "width": 8
    },

    "percent": {
      "type": 9,
      "color": {
        "green": "green",
        "yellow": "yellow",
	"red": "red"
      },
      "ndigits": 2
    },		/* 󰑃 */
   "separator": "~> ",
   "color": {
     "separator": "31"
   }
},

"modules": [
    "break",
    {
    "type": "command",
    "key": "DISTRO ",
    "keyColor": "31",
    "text": ". /etc/os-release; printf '%s %s' \"$PRETTY_NAME\" \"$(fastfetch -c none -l none -s cpu --format json | tr -d ' ,\"' | sed -n 's/^march://p')\""
    },
    {
    "type": "bios",
    "key": "/│/ ╠ ",
    "keyColor": "31",
    "format": "{5}"
    },
    {
    "type": "kernel",
    "key": "/│/ ╠ ",
    "keyColor": "31"
    },
    {
    "type": "shell",
    "key": "/│/ ╠ ",
    "keyColor": "31"
    },
    {
    "type": "command",
    "key": "/│/ ╠ ",
    "keyColor": "31",
    "text": "fastfetch -c none -l none -s packages:processes --format json | tr -d ' ,\"' | awk -F: '/^nixSystem/{s=$2} /^nixUser/{u=$2} /^result:[0-9]/{p=$2} END{printf \"%s (system), %s (user) - %s Active\", s, u, p}'"
    },
    {
    "type": "wm",
    "key": " DE/WM ",
    "keyColor": "light_yellow"
    },
    {
    "type": "wmtheme",
    "key": "/│/ ╠ ",
    "keyColor": "light_yellow"
    },
    {
    "type": "icons",
    "key": "/│/ ╠ ",
    "keyColor": "light_yellow"
    },
    {
        "type": "cursor",
        "key": "/│/ ╠ ",
        "keyColor": "light_yellow",
    },
    {
        "type": "terminalfont",
        "key": "/│/ ╠ ",
        "keyColor": "light_yellow",
    },
    {
    "type": "terminal",
    "key": "/│/ ╠ ",
    "keyColor": "light_yellow"
    },
    {
    "type": "Board",
    "key": "󰌢 SYSTEM ",
    "keyColor": "blue",
    "format": "{1} {2}"
    },
    {
    "type": "cpu",
    "key": "/│/ ╠ ",
    "keyColor": "blue",
    "format": "{1}:"
    },
    {
    "type": "cpu",
    "temp": true,
    "key": "/│/ ╠    ╚ ",
    "keyColor": "blue",
    "format": "{3} Cores | {4} Logical Cores | {8}"
    },
    {
    "type": "cpu",
    "temp": true,
    "key": "/│/ ╠    ╚ ",
    "keyColor": "blue",
    "format": "Max: {7} | Base: {6}"
    },
    {
    "type": "loadavg",
    "key": "/│/ ╠    ╚ ",
    "keyColor": "blue",
    "format": "{1} (1m) | {2} (5m) | {3} (15m)"
    },
    {
    "type": "CPUUsage",
    "percent": {
	"type": 9,
	"green": 83,
	"yellow": 89,
	"red": 94
    },
    "key": "/│/ ╠    ╚ ",
    "keyColor": "blue",
    "format": "Max: {2} | Avg: {1}"
    },
    {
    "type": "gpu",
    "key": "/│/ ╠ ",
    "format": "{1} {2}:",
    "keyColor": "blue"
    },
    {
    "type": "gpu",
    "key": "/│/ ╠    ╚ ",
    "format": "{3}",
    "keyColor": "blue"
    },
    {
    "type": "display",
    "key": "/│/ ╠ ",
    "keyColor": "blue",
    /*"compactType": "original-with-refresh-rate"*/
    "format": "{1} x {2} @ {3}Hz | {6}"
    },
    {
    "type": "memory",
    "percent": {
	"type": 3,
	"green": 50,
	"yellow": 80,
	"red": 93
    },
    "key": "/│/ ╠ ",
    "keyColor": "blue",
    "format": "{1}/{2} ({3}) {4} {#1;34}󰘚{#}"
    },
    {
    "type": "swap",
    "percent": {
	"type": 3,
	"green": 50,
	"yellow": 80,
	"red": 93
    },
    "key": "/│/ ╠ ",
    "keyColor": "blue",
    "format": "{1}/{2} ({3}) {4} {#1;34}{#}"
    },
    {
    "type": "disk",
    "percent": {
	"type": 3,
	"green": 70,
	"yellow": 85
    },
    "key": "/│/ ╠ ",
    "keyColor": "blue",
    "format": "{size-used}/{size-total} ({size-percentage}) {size-percentage-bar} {#1;34}{filesystem} 󰋊{#}"
    },
    {
    "type": "TPM",
    "key": "/│/ ╠ ",
    "keyColor": "blue",
    "format": "{2}"
    },
    {
    "type": "uptime",
    "key": "/│/ ╠ ",
    "keyColor": "blue"
    },
    {
    "type": "users",
    "key": "/│/ ╠ ",
    "keyColor": "blue",
    "format": "{1}@{2} - {5:16}"
    },
    {
    "type": "mouse",
    "key": "ACCESSORIES ",
    "keyColor": "light_green"
    },
    {
    "type": "keyboard",
    "key": "/│/ ╠    ╚ ",
    "keyColor": "light_green"
    },
    /*{
    "type": "localip",
    "key": "/│/ ╠ ",
    "keyColor": "blue"
    },*/
    {
      "type": "poweradapter",
      "keyIcon": "󰚥"
    },
    /*{
    "type": "host",
    "key": "/│/ ╠ ",
    "keyColor": "blue",
    "fallback": "Cool build bro! 😎",
    "format": "{1}{2}"
    },*/
    /*{
     "type": "command",
     "key": "Host",
     "text": "cat /sys/devices/virtual/dmi/id/product_name 2>/dev/null || echo 'Cool build bro! 😎'"
    },*/
    {
    "type": "sound",
    "key": " AUDIO ",
    "format": "{3:22} ({4}) {6} {#38;5;99}󰕾{#}",
    "keyColor": "38;5;99",
    "percent": {
	"type": 3,
	"green": "100",
    }
    },
    {
    "type": "player",
    "key": "/│/ ╠ ",
    "keyColor": "38;5;99"
    },
    {
    "type": "media",
    "key": "/│/ ╠ ",
    "keyColor": "38;5;99"
    },
    /*{*/
    /*"type": "weather",*/
    /*"key": " ",*/
    /*is a lil' snowman :holding back tears:*/   
    /*"format": "  {1}",*/
    /*"timeout": 2000*/
    /*},*/
    "break",
    {
    "type": "custom",
    /*"format": "\u001b[90m  \u001b[31m  \u001b[32m  \u001b[33m  \u001b[34m  \u001b[35m  \u001b[36m  \u001b[37m  \u001b[38m  \u001b[39m  \u001b[39m    \u001b[38m  \u001b[37m  \u001b[36m  \u001b[35m  \u001b[34m  \u001b[33m  \u001b[32m  \u001b[31m  \u001b[90m "*/

    /*Great pastel coloring :smile:*/
    /*"format": "\u001b[38;5;153m  \u001b[38;5;159m  \u001b[38;5;151m  \u001b[38;5;218m  \u001b[38;5;182m  \u001b[38;5;159m  \u001b[38;5;151m  \u001b[38;5;218m  \u001b[38;5;182m  \u001b[38;5;153m  \u001b[38;5;159m  \u001b[38;5;151m  \u001b[38;5;218m  \u001b[38;5;182m  \u001b[38;5;159m  \u001b[38;5;151m  \u001b[38;5;218m  \u001b[38;5;182m  \u001b[38;5;153m  \u001b[38;5;159m  \u001b[38;5;151m  \u001b[0m"*/
    
    /*Slightly stronger pastel*/
    /*"format": "\u001b[38;5;117m  \u001b[38;5;120m  \u001b[38;5;212m  \u001b[38;5;207m  \u001b[38;5;117m  \u001b[38;5;120m  \u001b[38;5;212m  \u001b[38;5;207m  \u001b[38;5;117m  \u001b[38;5;120m  \u001b[38;5;212m  \u001b[38;5;207m  \u001b[38;5;117m  \u001b[38;5;120m  \u001b[38;5;212m  \u001b[38;5;207m  \u001b[38;5;117m  \u001b[38;5;120m  \u001b[38;5;212m  \u001b[38;5;207m  \u001b[0m"*/
    
    /*Best color so far and here one  */
    "format": "\u001b[38;5;99m  \u001b[38;5;117m  \u001b[38;5;120m  \u001b[38;5;164m  \u001b[38;5;213m  \u001b[38;5;219m  \u001b[38;5;159m  \u001b[38;5;123m  \u001b[38;5;99m  \u001b[38;5;117m  \u001b[38;5;120m  \u001b[38;5;164m  \u001b[38;5;213m  \u001b[38;5;219m  \u001b[38;5;159m  \u001b[38;5;123m  \u001b[38;5;99m  \u001b[38;5;117m  \u001b[38;5;120m  \u001b[0m"
    },
    "break",
    ]
}
