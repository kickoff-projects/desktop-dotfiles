/* Rainbow palette - matches the waybar/kakoune neon accent colors.
 * The account layer (users/<name> or a host layer) replaces this file to
 * switch rofi's look; config.rasi's @theme "account.rasi" is the only
 * thing that ever needs to stay the same. */
* {
    background:     #1a0e22cc;
    background-alt: #2a1a38cc;
    foreground:     #eee8d5ff;
    selected:       #00d4c7ff;
    active:         #ffea00ff;
    urgent:         #ff2b2bff;

    background-color: @background;
    text-color:        @foreground;
}

window {
    border:        2px;
    border-color:  @selected;
    border-radius: 10px;
    width:         30%;
}

mainbox {
    children: [ inputbar, listview ];
}

inputbar {
    children: [ prompt, entry ];
    background-color: @background-alt;
    border-radius: 8px;
    padding: 8px;
}

entry, prompt {
    text-color: @foreground;
}

listview {
    lines: 8;
    spacing: 4px;
}

element {
    padding: 6px;
    border-radius: 6px;
}

element selected {
    background-color: @selected;
    text-color: @background;
}
