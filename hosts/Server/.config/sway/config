# Sway, not hyprland - a headless/minimal box. No blur, shadow or
# decoration block exists in sway, so "effects stripped" needed no
# configuring beyond not being hyprland.
#
# Binds below are translated from common/.config/hypr/UserConfigs/Keybinds.conf,
# same mod key and letters where sway has an equivalent. Hyprland-only binds
# (layoutmsg layout tricks, the Vim submap) have no sway equivalent and are
# dropped here. Screenshot binds keep their keys but swap hyprshot for
# grim+slurp - see hosts/Server/configuration.nix for why.

# -------- Variables -------------------------
set $terminal foot
set $fileManager dolphin
set $menu rofi --show drun
set $mod Mod4

# -------- Look -------------------------------
default_border pixel 2
gaps inner 3
include ~/.config/sway/colors

# -------- Input -------------------------------
input type:keyboard {
    xkb_layout us
    repeat_rate 50
    repeat_delay 300
}

focus_follows_mouse no
floating_modifier Mod1 normal

# -------- Focus / move / resize ---------------
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

bindsym Mod1+h move left
bindsym Mod1+l move right
bindsym Mod1+k move up
bindsym Mod1+j move down

bindsym $mod+Tab focus next
bindsym $mod+a focus prev sibling

bindsym $mod+Shift+h resize shrink width 70px
bindsym $mod+Shift+l resize grow width 70px
bindsym $mod+Shift+j resize grow height 70px
bindsym $mod+Shift+k resize shrink height 70px

bindsym Mod1+Tab layout toggle split

# -------- General applications ----------------
bindsym $mod+n exec $terminal
bindsym $mod+q kill
bindsym $mod+e exec $fileManager
bindsym Ctrl+Shift+0 exit

bindsym $mod+r exec $menu
bindsym $mod+f exec firefox
bindsym Ctrl+Shift+f exec firefox --private-window
bindsym $mod+d exec discord
bindsym $mod+w exec thunar

bindsym $mod+b exec $terminal btop

# -------- Workspaces ---------------------------
bindsym $mod+1 workspace 1
bindsym $mod+2 workspace 2
bindsym $mod+3 workspace 3
bindsym $mod+4 workspace 4
bindsym $mod+5 workspace 5

bindsym $mod+Shift+1 move container to workspace 1
bindsym $mod+Shift+2 move container to workspace 2
bindsym $mod+Shift+3 move container to workspace 3
bindsym $mod+Shift+4 move container to workspace 4
bindsym $mod+Shift+5 move container to workspace 5

# -------- Volume --------------------------------
bindsym XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle

bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPause exec playerctl play-pause
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioPrev exec playerctl previous

# -------- Screenshot (grim+slurp, not hyprshot) -
bindsym Ctrl+Shift+x exec grim -g "$(slurp)" ~/Pictures/$(date +%Y-%m-%d_%H-%m-%s).png
bindsym Ctrl+Shift+a exec grim -g "$(slurp)" - | wl-copy
bindsym Ctrl+Shift+s exec grim -g "$(swaymsg -t get_tree | jq -j '.. | select(.focused?) | .rect | "\(.x),\(.y) \(.width)x\(.height)"')" - | wl-copy

# -------- Status bar -----------------------------
bar {
    swaybar_command waybar
}
