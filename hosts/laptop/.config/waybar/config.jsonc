// -----------------------

    "disk": {
        "interval": 5,
        "format": "󰋊 {percentage_used}%",
        "path": "/",
        "tooltip": true,
        "unit": "GB",
        "tooltip-format":  "Available {free} of {total}"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    },

    "clock": {
	"interval": 1,
       "format": "{:%H:%M:%OS          %d / %m   %U}",
        "format-alt": "{:%Y-%m-%d}",
        "tooltip-format": "<big>{:%A, %B %d, %Y}</big>\n<small>{calendar}</small>",
	"calendar": {
            "mode": "month",
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#eee8d5'>{}</span>",
                "weeks": "<span color='#93a1a1'>{}</span>",
                "weekdays": "<span color='#268bd2'>{}</span>",
                "today": "<span color='#d33682'><b>{}</b></span>"
            },
        },
        "actions": {
            "on-click-right": "mode",
            "on-click-forward": "tz_up",
            "on-click-backward": "tz_down",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    // one module per physical link, each pinned by interface: the Proton kill
    // switch adds an IPv6 default route on the dummy device ipv6leakintrf0 with
    // metric 95, which beats the metric 100 route of a real link, so
    // route-based interface choice can track the dummy device instead.
    // Waybar hides a module whose text is empty, so each link shows a line only
    // while that link is up, and no module carries a "no network" text.
    "network#wifi": {
	"interface": "wlp0s20f3",
	"format-wifi" : "󰕒 {bandwidthUpBytes} 󰇚 {bandwidthDownBytes} 󰖩 {signalStrength}% ",
	"format-linked": "󱘖 {ifname} 󰕒 {bandwidthUpBytes} 󰇚 {bandwidthDownBytes} ",
	"format-disconnected": "",
	"tooltip-format": "{ifname} | 󰖩 {essid} ({signalStrength}%)   ",
        "interval": 1,
        "tooltip": true,
    },

    "network#eth": {
	"interface": "enp52s0",
	"format-ethernet": "󰕒 {bandwidthUpBytes} 󰇚 {bandwidthDownBytes} 󰈀  ",
	"format-linked": "󱘖 {ifname} 󰕒 {bandwidthUpBytes} 󰇚 {bandwidthDownBytes} ",
	"format-disconnected": "",
	"tooltip-format": "{ifname} ",
        "interval": 1,
        "tooltip": true,
    },

    "cpu": {
        "format": "CPU: 󰍛 {usage}%/{load} {avg_frequency:.2f}/{max_frequency:.2f} GHz",
        "tooltip": true,
        "interval": 1
    },

    "temperature": {
	"thermal-zone": 2,
	"interval": 10,
        "critical-threshold": 90,
        "format": "{icon} {temperatureC}°C",
        "format-critical": "󰸁 {temperatureC}°C",
        "format-icons": ["󱃃", "󰔏", "󱃂"]
    },

    "group/cpu_info": {
	"orientation": "horizontal",
	"modules": [
		"cpu",
		"temperature"
	]

    },

    "custom/nvidia": {
     // Gated on the dGPU's PCI runtime state: reading power/runtime_status
     // does not touch the device, but every nvidia-smi call wakes it out of
     // RTD3 and holds it awake, which would cancel
     // hardware.nvidia.powerManagement.finegrained (see
     // system/hardware/nvidia_prime_power.nix). The awake branch is the
     // Desktop's exec byte for byte with only " -lms 1000" removed, so the
     // line it prints is identical; the Desktop keeps the continuous poll,
     // which costs it nothing.
     // Bus id is the nvidiaBusId nixos-hardware sets for this host.
     "exec": "if [ \"$(cat /sys/bus/pci/devices/0000:01:00.0/power/runtime_status 2>/dev/null)\" = active ]; then nvidia-smi --id=0 --query-gpu=pstate,utilization.memory,utilization.gpu,temperature.gpu --format=csv,noheader,nounits | awk -F', ' '{t=$4+0; i=(t<50?\"󱃃\":(t<75?\"󰔏\":(t<85?\"󱃂\":\"󰸁\"))); printf \"GPU: 󰉁 %s 󰘚 %s%% 󰓅 %s%% %s %s°C\\n\", $1, $2, $3, i, t; fflush()}'; else echo \"GPU: 󰿘 rtd3\"; fi",
     // 10s, not 5: a poll that lands while the device is still "active"
     // resets its autosuspend timer, so an interval at or below the delay
     // (power/autosuspend_delay_ms, 5000 by default) can hold the dGPU awake
     // by itself after an offloaded app exits. Check the real delay with
     // "cat /sys/bus/pci/devices/0000:01:00.0/power/autosuspend_delay_ms"
     // and keep this above it.
     "interval": 10
    },

    "memory": {
        "format": "󰘚 {percentage}%  {swapPercentage}%",
        "tooltip-format": "{used:0.1f}GB / {total:0.1f}GB  {swapUsed}GB / {swapTotal}GB",
        "interval": 1
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "format-icons": {
            "headphone": "󰋋",
            "hands-free": "󰋎",
            "headset": "󰋎",
            "phone": "󰏲",
            "portable": "󰏲",
            "car": "󰄋",
            "default": ["󰕿", "󰖀", "󰕾"]
         },
          "on-click": "pavucontrol",
          "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
      },

    "backlight": {
      "interval": 1,
      "device": "intel_backlight",
      "format": "{icon}{percent}%",
      "format-icons": [
	" ",
	" ",
	" ",
	"󰃝 ",
	"󰃞 ",
	"󰃟 ",
	"󰃠 "
      ],
      "on-scroll-down": "brightnessctl s 1%-",
      "on-scroll-up": "brightnessctl s +1%",
      "tooltip": true,
      "tooltip-format": "Brightness: {percent}% ",
      "smooth-scrolling-threshold": 1
  },

    "group/system-info": {
	"orientation": "horizontal",
	"modules": [
                "backlight",
		"pulseaudio",
                "pulseaudio#microphone"
		
	]
    },

    // vpn state is event-driven from NetworkManager: the script sleeps on
    // `nmcli monitor`, so there is no interval and no polling cost
    "custom/protonvpn": {
	"exec": "bash $HOME/.config/hypr/scripts/waybar-protonvpn.sh",
	"return-type": "json",
	"restart-interval": 5
    },

    // mic state comes from the source fields of the native pulseaudio
    // module, which sets the "source-muted" class itself, so both colors
    // live in style.css. This is a second pulseaudio instance: its CSS id
    // stays #pulseaudio and "microphone" is a class on it. A machine with
    // no capture device keeps the open-mic style, because waybar has no
    // class for a missing source.
    "pulseaudio#microphone": {
	"format": "{format_source}",
	"format-source": "  ",
	"format-source-muted": "  ",
	"tooltip-format": "Microphone | {source_volume}%",
	// click mutes the mic, scroll changes its volume. Native scroll moves
	// the sink volume, so these two keys are what reach the source.
	"on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
	"on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SOURCE@ 5%+",
	"on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-"
    },

    "battery": {
        "states": {
            "good": 95,
            "warning": 35,
            "critical": 20
        },
        "format": "{icon} {capacity}% ",
        "format-charging": "󰂄 {capacity}% ",
        "format-plugged": "󰚥 {capacity}% ",
        "format-alt": "{icon} {time} \n {health} {cycles}",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        // custom/battery-min below has no interval. It updates only on
        // SIGRTMIN+9, and this line sends that signal on every update of
        // this module. The percentage and the minute count therefore always
        // come from the same reading, and the pair needs no second timer.
        // The rate follows this module's own interval, 60 by default.
        "on-update": "pkill -RTMIN+9 waybar"
    },

    // The minute count, which the battery module cannot print: its
    // format-time splits hours from minutes and has no total-minutes
    // argument, so {M} is the 0-59 remainder.
    // The dash lives in this module's format. The module hides itself when
    // the awk file prints nothing, which is every case without an estimate,
    // and the dash then goes with it.
    "custom/battery-min": {
        "exec": "awk -f $HOME/.config/hypr/scripts/battery-minutes.awk /sys/class/power_supply/BAT0/uevent",
        "signal": 9,
        "format": "- {}"
    },

    // One box for the pair. A group has no spacing, so the two modules
    // touch, and the facing margins and corners in style.css then join
    // their underlines into one line.
    "group/battery_info": {
        "orientation": "horizontal",
        "modules": [
            "battery",
            "custom/battery-min"
        ]
    }

}
