//        "format": "{icon} {id}",
//        "on-click": "activate",
//        "all-outputs": true,
//        "sort-by-number": true,
//        "format-icons": {
//	"1": "  /\\_/\\  \n ~(≧▽≦)~  \n   >づづ  ",
//        "2": "  /\\_/\\  \n (• . •?)  \n  >づづ   ",
//        "3": "  /\\_/\\  \n   (ฅ• . •ฅ) ♡  \n  > づづ ",
//        "4": "  /\\_/\\  \n ( - ω - ) zzZ  \n  >  ⊃⊃ ",
//        "5": "  /\\_/\\  \n  (O_O;)  \n  >づづ  ",
//        "6": "  /\\_/\\  \n ( • ω • )  \n / づ ♡  ",
//        "7": "  /\\_/\\  \n  (¬‿¬)  \n  >づづ  ",
//        "8": "  /\\_/\\  \n (°w°)  \n  >づづ  ",
//        "9": "  /\\_/\\  \n  (≖_≖)  \n  >づづ  ",
//        "10": " /\\_/\\  \n (✿^‿^)  \n  >づづ ",
//        "urgent": "  /\\_/\\  \n (⊙﹏⊙;)  \n  >づづ  ",
//	"active": "  ∧,,,∧         ♡♡\n(  ̳• · • ̳)   you\n/    づ ♡ I love   ",
//	"default": "  /\\_/\\  \n (°w°)  \n  >づづ"
//        }
